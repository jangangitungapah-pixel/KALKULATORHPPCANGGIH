<Window
    x:Class="Hpp.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Hpp.WinUI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KALKULATORHPPCANGGIH"
    Width="1360"
    Height="860"
    MinWidth="1080"
    MinHeight="720">

    <Grid x:Name="RootGrid" Background="{ThemeResource BrandCanvasBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarDragRegion"
                Background="{ThemeResource BrandTitleBarBrush}"
                Padding="16,10,16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xECA5;" FontSize="18" Foreground="{ThemeResource BrandHighlightBrush}" />
                    <StackPanel>
                        <TextBlock Text="KALKULATORHPPCANGGIH" Style="{ThemeResource TitleTextStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextStyle}" Opacity="0.9" />
                    </StackPanel>
                </StackPanel>

                <AutoSuggestBox Grid.Column="1"
                                PlaceholderText="Search command or module"
                                Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                QueryIcon="Find"
                                IsSuggestionListOpen="False" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{ThemeResource PillBadgeStyle}">
                        <TextBlock Text="Ctrl+K" />
                    </Border>
                    <Button Content="Open Palette" Click="OnOpenPaletteClick" Style="{ThemeResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Border Background="{ThemeResource BrandPanelBrush}" CornerRadius="16" />

            <NavigationView x:Name="ShellNav"
                            PaneDisplayMode="LeftCompact"
                            IsBackButtonVisible="Collapsed"
                            SelectionChanged="OnNavigationSelectionChanged"
                            AutomationProperties.Name="Main navigation"
                            IsPaneToggleButtonVisible="True"
                            IsSettingsVisible="False"
                            Background="Transparent"
                            Margin="2">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                    <NavigationViewItem Content="Inventory" Tag="Inventory" Icon="AllApps" />
                    <NavigationViewItem Content="Item Detail" Tag="ItemDetail" Icon="Contact" />
                    <NavigationViewItem Content="Scenario Studio" Tag="Scenario" Icon="Calculator" />
                    <NavigationViewItem Content="Batch Trace" Tag="BatchTrace" Icon="Library" />
                    <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
                </NavigationView.MenuItems>
                <NavigationView.PaneFooter>
                    <Border Margin="8,12,8,14" Padding="12" Style="{ThemeResource GlassCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Realtime Cost Intelligence" Style="{ThemeResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Pipeline status: online" Style="{ThemeResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </NavigationView.PaneFooter>
                <NavigationView.Content>
                    <Frame x:Name="ContentFrame">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition DefaultNavigationTransitionInfo="DrillInNavigationTransitionInfo" />
                                <EntranceThemeTransition FromHorizontalOffset="22" />
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </NavigationView.Content>
            </NavigationView>
        </Grid>

        <helpers:CommandPalette x:Name="CommandPalette" />
    </Grid>
</Window>
