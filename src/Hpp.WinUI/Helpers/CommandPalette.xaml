<UserControl
    x:Class="Hpp.WinUI.Helpers.CommandPalette"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Popup x:Name="PalettePopup" IsLightDismissEnabled="True">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="16"
                CornerRadius="8"
                Width="540"
                AutomationProperties.Name="Command palette">
            <StackPanel Spacing="8">
                <TextBlock Text="Command Palette" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="CommandTextBox" PlaceholderText="Type a command..." TextChanged="OnCommandTextChanged" />
                <ListView x:Name="CommandList" ItemsSource="{Binding FilteredCommands, ElementName=Root}" Height="240" SelectionChanged="OnListSelectionChanged" DoubleTapped="OnListDoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                                <TextBlock Text="{Binding Key}" Width="90" Foreground="Gray" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Execute" HorizontalAlignment="Right" Click="OnExecuteClick" />
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
