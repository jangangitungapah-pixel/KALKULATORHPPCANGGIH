<UserControl
    x:Class="Hpp.WinUI.Helpers.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Popup x:Name="PalettePopup" IsLightDismissEnabled="True">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="16"
                CornerRadius="8"
                Width="420"
                AutomationProperties.Name="Command palette">
            <StackPanel Spacing="8">
                <TextBlock Text="Command Palette" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="CommandTextBox" PlaceholderText="Type a command..." />
                <TextBlock Text="TODO: Wire commands" Foreground="Gray" />
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
