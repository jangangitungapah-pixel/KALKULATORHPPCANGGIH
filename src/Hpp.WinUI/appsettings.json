{
  "ConnectionStrings": {
    "HppDb": "__DEV_DB_CONN__"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/hpp-.log",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "__SEQ_URL__"
        }
      }
    ]
  }
}
